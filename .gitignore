# Ignore dependencies
node_modules/
__pycache__/
*.pyc
src-tauri/target/

# Ignore logs
*.log

# Ignore cloned repos
gemini-cli/

# Ignore temporary artifacts
.tmp
.temp

# Ignore local bootstrap state and secrets
.bootstrap-tools/
secrets/
# Never commit backup dumps
.bootstrap-tools/*.bak
.bootstrap-tools/ui-runs/

# Local run logs (diagnostico de instalacao real)
.runlogs/

# Local IDE / agent worktrees
.trae/
.codex/
.rtk/
.vscode/
.claude/
.hermes/
.serena/
Microsoft/
.mcp.json
run_pester_*.ps1
tests/_parse-check.ps1
cookbook/
add-trap-handler.ps1
fix-backend-crash.ps1
# ntfs-3g/exfat leaves orphaned .ghost- copies on the SD card after interrupted writes
.ghost-ntfs-3g-*
**/.ghost-ntfs-3g-*
