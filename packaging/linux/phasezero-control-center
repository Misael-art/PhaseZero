#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
for root in \
    "${PHASEZERO_ROOT:-}" \
    "/usr/lib/phasezero" \
    "/app/lib/phasezero" \
    "$(cd "$(dirname "$SELF")/../.." 2>/dev/null && pwd)"
do
    if [ -n "$root" ] && [ -x "$root/linux/ui/native.sh" ]; then
        exec "$root/linux/ui/native.sh" "$@"
    fi
done

echo "PhaseZero installation not found" >&2
exit 127
