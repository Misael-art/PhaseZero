{
  "schema": "https://phasezero.local/schemas/profile.json",
  "name": "server-homelab",
  "description": "Home server (Drive/media/vault/monitor) via Docker + Tailscale remote access",
  "os": ["linux", "windows"],
  "packages": {
    "linux": {
      "pacman": ["docker", "docker-compose", "git", "rsync", "tailscale", "jq"],
      "yay": [],
      "flatpak": []
    },
    "windows": {
      "winget": ["Docker.DockerDesktop"],
      "choco": ["docker-desktop", "tailscale"]
    }
  },
  "scripts": {
    "linux": ["linux/server/apply-server-homelab.sh"]
  },
  "systemd": {
    "linux": {
      "enable": ["docker", "tailscaled"],
      "user": []
    }
  },
  "tuning": {
    "linux": {
      "sysctl": {
        "net.ipv4.ip_forward": 1,
        "vm.max_map_count": 262144,
        "fs.inotify.max_user_watches": 65536
      }
    }
  }
}
