        *)            pz_error "usage: pz emulation (layout|status|blocked-sources|emudeck|retrodeck|eden|citron|hydra|heroic|srm|ps1|ps2|ps3|performance|lua|steam-tools|fixes|bios|switch|shared|media|pc-games|shortcuts|launchbox|frontends|doctor|setup)"; return 1 ;;
