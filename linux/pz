        shortcuts|desktop-shortcuts|launchers) bash "$PZ_ROOT/linux/emulation/shortcuts.sh" "${target:-status}" "${extra[@]}" ;;
        launchbox|bigbox) bash "$PZ_ROOT/linux/emulation/launchbox.sh" "${target:-status}" "${extra[@]}" ;;
        frontends|frontend-switcher) bash "$PZ_ROOT/linux/emulation/frontends.sh" "${target:-status}" "${extra[@]}" ;;
        fixes)        bash "$PZ_ROOT/linux/emulation/fixes.sh" "${target:-list}" "${extra[@]}" ;;
        bios)         bash "$PZ_ROOT/linux/emulation/bios.sh" "${target:-status}" "${extra[@]}" ;;
        switch)       bash "$PZ_ROOT/linux/emulation/bios.sh" "switch-${target:-status}" "${extra[@]}" ;;
        doctor)       local rc=0
                      if $has_json; then
                          bash "$PZ_ROOT/linux/emulation/shared-content.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/media.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/srm.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/ps3.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/pc-games.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/heroic.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/shortcuts.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/launchbox.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/frontends.sh" status --json || rc=1
                          bash "$PZ_ROOT/linux/emulation/performance.sh" status || rc=1
                      else
                          bash "$PZ_ROOT/linux/emulation/shared-content.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/media.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/srm.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/ps3.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/pc-games.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/heroic.sh" status || rc=1
                          bash "$PZ_ROOT/linux/emulation/shortcuts.sh" status || rc=1
