cmd_ai() {
    local sub="${1:-}" target="${2:-}"
    [ -z "$sub" ] && { pz_error "usage: pz ai (status|setup|compat|secrets|mcp) ..."; return 1; }
    case "$sub" in
        status)
            bash "$PZ_ROOT/linux/ai/status.sh"
            ;;
        doctor)
            bash "$PZ_ROOT/linux/ai/mcp-manager.sh" doctor
            ;;
        repair)
            bash "$PZ_ROOT/linux/ai/mcp-manager.sh" repair all
            bash "$PZ_ROOT/linux/ai/setup-ides.sh" configure >/dev/null || pz_warn "IDE integration repair skipped"
            ;;
        menu|ui)
            bash "$PZ_ROOT/linux/ai/menu.sh"
            ;;
        desktop|desktop-apps)
            shift
            bash "$PZ_ROOT/linux/ai/desktop-apps.sh" "${@:-status}"
            ;;
        compat|agent-compat|tools)
            shift
            bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" "${@:-status}"
            ;;
        admin|admin-bridge|bigsudo)
            shift
            bash "$PZ_ROOT/linux/ai/setup-admin-bridge.sh" "${@:-status}"
            ;;
        setup)
            [ -z "$target" ] && target="all"
            case "$target" in
                codex)    bash "$PZ_ROOT/linux/ai/setup-codex.sh" ;;
                ollama)   bash "$PZ_ROOT/linux/ai/setup-ollama.sh" ;;
                webui)    bash "$PZ_ROOT/linux/ai/setup-open-webui.sh" ;;
                claude)   bash "$PZ_ROOT/linux/ai/setup-claude-code.sh" ;;
                desktop|desktop-apps)
                    bash "$PZ_ROOT/linux/ai/desktop-apps.sh" install-claude
                    bash "$PZ_ROOT/linux/ai/desktop-apps.sh" install-services
                    ;;
                opencode) bash "$PZ_ROOT/linux/ai/setup-opencode.sh" ;;
                hermes)   bash "$PZ_ROOT/linux/ai/setup-hermes.sh" ;;
                openclaw) bash "$PZ_ROOT/linux/ai/setup-openclaw.sh" ;;
                memory|ai-memory) bash "$PZ_ROOT/linux/ai/setup-memory.sh" setup ;;
                admin|admin-bridge|bigsudo) bash "$PZ_ROOT/linux/ai/setup-admin-bridge.sh" setup ;;
                rtk)      bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" install-rtk ;;
                caveman|caverman) bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" rules ;;
                headroom) bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" headroom ;;
                frugality|ai-context-frugality) bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" frugality ;;
                compat|agent-compat|tools) bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" setup ;;
                ides|ide) bash "$PZ_ROOT/linux/ai/setup-ides.sh" configure ;;
                ide-apps|ides-apps) bash "$PZ_ROOT/linux/ai/setup-ides.sh" install-apps ;;
                usagebar|ai-usagebar) bash "$PZ_ROOT/linux/ai/setup-usagebar.sh" setup ;;
                all)
                    bash "$PZ_ROOT/linux/ai/setup-codex.sh"
                    bash "$PZ_ROOT/linux/ai/setup-ollama.sh"
                    bash "$PZ_ROOT/linux/ai/setup-open-webui.sh"
                    bash "$PZ_ROOT/linux/ai/setup-claude-code.sh"
                    bash "$PZ_ROOT/linux/ai/desktop-apps.sh" install-claude
                    bash "$PZ_ROOT/linux/ai/desktop-apps.sh" install-services
                    bash "$PZ_ROOT/linux/ai/setup-opencode.sh"
                    bash "$PZ_ROOT/linux/ai/setup-hermes.sh"
                    bash "$PZ_ROOT/linux/ai/setup-openclaw.sh"
                    bash "$PZ_ROOT/linux/ai/setup-memory.sh" setup
                    bash "$PZ_ROOT/linux/ai/setup-admin-bridge.sh" setup
                    bash "$PZ_ROOT/linux/ai/setup-agent-compat.sh" setup
                    bash "$PZ_ROOT/linux/ai/setup-usagebar.sh" setup
                    bash "$PZ_ROOT/linux/ai/setup-ides.sh" configure
                    ;;
                *) pz_error "unknown tool: $target"; return 1 ;;
            esac
            ;;
        secrets)
            case "${target:-rotate}" in
                rotate) bash "$PZ_ROOT/linux/ai/rotate-secrets.sh" ;;
                *) pz_error "usage: pz ai secrets rotate"; return 1 ;;
            esac
            ;;
        mcp)
            case "${target:-list}" in
                install) bash "$PZ_ROOT/linux/ai/mcp-manager.sh" install "${3:-}" "${4:-all}" ;;
                sync) bash "$PZ_ROOT/linux/ai/mcp-manager.sh" sync "${3:-all}" ;;
                sync-all|configure-all) bash "$PZ_ROOT/linux/ai/mcp-manager.sh" sync-all "${3:-all}" ;;
