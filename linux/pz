cmd_tune() {
    local area="${1:-}"
    [ -z "$area" ] && { pz_error "usage: pz tune (browser|gaming|dev)"; return 1; }
    case "$area" in
        browser) bash "$PZ_ROOT/linux/tuning/browser-hardening.sh" ;;
        gaming)  bash "$PZ_ROOT/linux/tuning/gaming-tweaks.sh" ;;
        dev)     bash "$PZ_ROOT/linux/tuning/dev-tweaks.sh" ;;
        *)       pz_error "unknown tune area: $area"; return 1 ;;
