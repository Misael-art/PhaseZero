cmd_ui() {
    local action="${1:-server}" port="${2:-auto}"
    case "$action" in
        server)
            local port_arg=""
            [ "$port" != "auto" ] && port_arg="--port $port"
            python3 "$PZ_ROOT/linux/ui/server.py" $port_arg
            ;;
        tui)
            bash "$PZ_ROOT/linux/ui/tui.sh"
            ;;
        status)
            local pid_file="$PZ_STATE/ui-server.pid"
            if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                echo "UI server running (pid $(cat "$pid_file"))"
            else
                echo "UI server not running"
            fi
            ;;
        open|"")
            # start server in background and open browser
            local log_file="$PZ_STATE/ui-server.log"
            mkdir -p "$PZ_STATE"
            python3 "$PZ_ROOT/linux/ui/server.py" --daemon "$log_file" &
            local pid=$!
            echo "$pid" > "$PZ_STATE/ui-server.pid"
            sleep 1
            xdg-open "http://127.0.0.1:8080" 2>/dev/null || true
            echo "Dashboard: http://127.0.0.1:8080 (pid $pid)"
            ;;
        *)
            pz_error "usage: pz ui (server|tui|status|open)"
            return 1
            ;;
    esac
}

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true
    case "$cmd" in
        install)       cmd_install "$@" ;;
        steamdeck)     cmd_steamdeck "$@" ;;
        windows-vm|windows|winvm|win-vm) cmd_windows_vm "$@" ;;
        waydroid|android) cmd_waydroid "$@" ;;
        emulation)     cmd_emulation "$@" ;;
        ai)            cmd_ai "$@" ;;
        doctor)        cmd_doctor "$@" ;;
        support-bundle) cmd_support_bundle "$@" ;;
        repair-plan)   cmd_repair_plan "$@" ;;
        tune)          cmd_tune "$@" ;;
        ui)            cmd_ui "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h|"") usage ;;
        *)             pz_error "unknown command: $cmd"; usage; return 1 ;;
    esac
}

main "$@"
